{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in the system",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit and operation log entries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["id", "userId", "message"]
    },
    "TelemetryEvent": {
      "title": "TelemetryEvent",
      "description": "Real-time node telemetry stream data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nodeId": { "type": "string" },
        "coreLoad": { "type": "number" },
        "resonance": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "nodeId", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Global audit log documents"
    },
    "/telemetry/{eventId}": {
      "schema": { "$ref": "#/entities/TelemetryEvent" },
      "description": "Node telemetry documents"
    }
  }
}
